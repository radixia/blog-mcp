# wrangler's peer range for @cloudflare/workers-types moved to v5, while
# partyserver (a transitive peer of `agents`) still asks for v4. Both are TYPE
# packages: the conflict is advisory and does not affect the deployed Worker, but
# it makes npm refuse to install on any clean machine, which is how CI found it.
#
# Pinning either side would mean holding back wrangler or breaking partyserver, so
# the conflict is accepted explicitly here instead.
legacy-peer-deps=true
